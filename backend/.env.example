# ============================================================
# Cinema Booking System — Backend Environment Variables
# Copy this file to .env and fill in the values
# cp .env.example .env
# ============================================================

# App Server
PORT=8080
GIN_MODE=debug

# MongoDB Connection
# Use individual vars instead of MONGODB_URI to avoid & parsing issues
# in the custom .env file reader (values with query strings break on &).
MONGO_USER=cinema_admin
MONGO_PASSWORD=dev-mongo-password-change-me
MONGO_HOST=127.0.0.1:27017
MONGODB_DB=cinemadb
MONGO_REPLICA_KEY=dev-replica-key-change-me
MONGO_REPLICA_SET=rs0
MONGO_DIRECT_CONNECTION=true

# Redis Connection
# Use 127.0.0.1 instead of localhost (Docker Desktop WSL2 binds IPv4 only)
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=replace-me

# JWT Secrets (Required)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_HOURS=24

# Google OAuth 2.0
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# For Local Dev (Redirects to Go backend): http://localhost:8080/api/auth/google/callback
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
APP_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# Resend Email (https://resend.com — free 100 emails/day)
# Leave empty to use mock notifications (logs to console)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Cinema Booking <noreply@example.com>

# Seeded Admin Account (First time boot only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
