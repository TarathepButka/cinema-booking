# MongoDB
MONGO_ROOT_USER=cinema_admin
MONGO_ROOT_PASS=dev-mongo-password
MONGO_DB=cinemadb
MONGO_REPLICA_KEY=dev-replica-key
MONGO_REPLICA_SET=rs0

# Redis
REDIS_PASSWORD=dev-redis-password

# Authentication
JWT_SECRET=dev-jwt-secret-at-least-32-characters
JWT_EXPIRE_HOURS=24
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=dev-admin-password-12chars

# Local application origin
FRONTEND_URL=http://localhost
APP_ORIGINS=http://localhost,http://localhost:5173
GOOGLE_REDIRECT_URL=http://localhost/api/auth/google/callback
COOKIE_SECURE=false

# Google OAuth
GOOGLE_CLIENT_ID=dev-google-client-id
GOOGLE_CLIENT_SECRET=dev-google-client-secret

# Email
RESEND_API_KEY=dev-resend-api-key
RESEND_FROM_EMAIL=Cinema Booking <noreply@example.com>
